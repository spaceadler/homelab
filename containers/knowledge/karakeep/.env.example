# Karakeep. Reference: https://docs.karakeep.app/configuration
KARAKEEP_VERSION=release
NEXTAUTH_SECRET=__HEX64__
MEILI_MASTER_KEY=__HEX32__
# Turn on once your own account exists.
# DISABLE_SIGNUPS=true

# Optional: automatic tagging with a local Ollama (e.g. on your desktop's GPU).
# OLLAMA_BASE_URL=http://<ollama-host>:11434
# INFERENCE_TEXT_MODEL=llama3.2:3b
# INFERENCE_OUTPUT_SCHEMA=plain
