# CryptPad → http://workspace.<domain>, sandbox at http://workspacesb.<domain>.
# Both names go to the same server, which tells them apart by Host header.
server {
    include snippets/listen.conf;
    server_name workspace.* workspacesb.*;
    location / {
        proxy_pass http://${TS_IP}:7000;
        include snippets/proxy.conf;
    }
}
