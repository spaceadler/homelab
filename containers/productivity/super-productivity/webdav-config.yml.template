# WebDAV sync target for Super Productivity, rendered by install.sh into
# webdav-config.yml. The login is read from the container's environment at
# startup ({env}NAME), so the password never sits in this file.
address: 0.0.0.0
port: 6065
prefix: /webdav
directory: /data
behindProxy: true
permissions: CRUD

users:
  - username: "{env}WEBDAV_USERNAME"
    password: "{env}WEBDAV_PASSWORD"

cors:
  enabled: true
  credentials: true
  allowed_hosts:
    - ${URL_SCHEME}://schedule.${DOMAIN}
    - http://${TS_IP}:5432
  allowed_headers:
    - Authorization
    - Content-Type
    - Content-Range
    - Depth
    - Destination
    - If
    - Lock-Token
    - Overwrite
    - TimeOut
    - Translate
    - X-Update-Range
  allowed_methods:
    - COPY
    - DELETE
    - GET
    - HEAD
    - LOCK
    - UNLOCK
    - MKCOL
    - MOVE
    - OPTIONS
    - PATCH
    - POST
    - PROPFIND
    - PROPPATCH
    - PUT
  exposed_headers:
    - Content-Length
    - Content-Range
