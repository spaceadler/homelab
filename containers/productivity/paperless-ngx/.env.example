# Paperless-ngx. Reference: https://docs.paperless-ngx.com/configuration/
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=__PASS__
PAPERLESS_DB_PASSWORD=__PASS__
PAPERLESS_SECRET_KEY=__HEX64__
# OCR language(s), Tesseract codes joined with +, e.g. eng+deu.
PAPERLESS_OCR_LANGUAGE=eng
# Extra language packs to install beyond the built-in ones, space-separated.
PAPERLESS_OCR_LANGUAGES=
