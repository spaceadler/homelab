# "none": being on the tailnet is the login, the same trust that lets your
# devices reach storage/Notes over SSH or Syncthing.
# "password": a login page with the username and password below. Worth it if
# you share the tailnet with other people (other Tailscale accounts can reach
# this page, but not your SSH by default).
GLOBNOTES_AUTH_TYPE=none
GLOBNOTES_USERNAME=homelab
GLOBNOTES_PASSWORD=__PASS__
GLOBNOTES_SECRET_KEY=__HEX64__
