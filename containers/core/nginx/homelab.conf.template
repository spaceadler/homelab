# Rendered by install.sh into homelab.conf (your DOMAIN filled in), which
# nginx loads as conf.d/default.conf, inside its http block.

# Uploads: most apps want more than nginx's 1 MB default. Apps that need more
# (Immich, Trek) raise it in their own nginx.conf.
client_max_body_size 512m;

# WebSockets: upgrade the connection when the client asks for it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# A name that isn't one of your apps: drop the connection.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

# The bare domain: go to the home screen.
server {
    include snippets/listen.conf;
    server_name ${DOMAIN};
    return 302 ${URL_SCHEME}://os.${DOMAIN}$request_uri;
}

include /etc/nginx/sites/*.conf;
