# homelab.env: settings for the whole machine. install.sh creates
# homelab.env from this file on its first run, asks for the first three, and
# fills in the rest. After editing, re-run ./install.sh to push the change
# into every app.

# Every app lives under this name: Immich is http://gallery.<DOMAIN>.
DOMAIN=homelab.local
# Timezone, e.g. Europe/Berlin. Blank: taken from the host.
TZ=
# Where photos, music, documents and notes live. Blank: ./storage in this
# folder. Point it at a bigger disk if you have one, e.g. /mnt/data.
STORAGE_DIR=

# Owner of the files apps write. Blank: the user who runs install.sh.
PUID=
PGID=

# Read from Tailscale on every run. Set them by hand only with --no-host.
TS_IP=
VAULT_HOST=

# Apps to install, space-separated (core apps always are). Blank: install.sh
# shows a menu. The full list is containers/catalog.tsv.
APPS=

# adlerOS, the home screen: on, or off for the homelab on its own (no home
# screen, and no helper, which is adlerOS's). Blank: asked on the first run.
ADLEROS=
# It comes from its own repository; install.sh keeps a copy in
# containers/core/os/adleros. Blank: the main branch from
# https://github.com/spaceadler/adleros.git, else (if that can't be reached)
# each of ADLEROS_MIRRORS in turn, space-separated. Blank mirrors with a blank
# repo: https://git.spaceadler.com/spaceadler/adleros.git
ADLEROS_REPO=
ADLEROS_REF=
ADLEROS_MIRRORS=

# Who adlerOS answers: tailscale (your tailnet; empty means this too), anyone,
# or addresses and networks, comma-separated. ufw keeps the LAN out as well.
ADLEROS_NETWORKS=

# adlerOS's wallpapers: a folder in STORAGE_DIR. Empty: Other/Wallpapers.
WALLPAPER_DIR=
# adlermd's first vault: a folder of notes in STORAGE_DIR. Empty: Notes.
NOTES_DIR=
# Music's songs and playlists (.m3u8): a folder in STORAGE_DIR. Empty: Media/Music.
MUSIC_DIR=
# Music's plays in Navidrome too (now playing, then played): your Navidrome
# login. Empty: off. NAVIDROME_URL if it isn't at this machine's address
# and Navidrome's port.
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_URL=
# Gallery: your photos from Immich. An API key made in Immich (Account
# Settings, API Keys) that may read: asset.read, asset.view, asset.download,
# album.read, person.read, memory.read, face.read, map.read. IMMICH_URL if Immich isn't at this
# machine's address and its port in the store.
IMMICH_API_KEY=
IMMICH_URL=
# Without a key, Gallery shows the photos themselves, from this folder in
# STORAGE_DIR (Immich's library, or any folder of photos). Empty: Gallery.
GALLERY_DIR=
# Documents: your papers from Paperless-ngx. A token from Paperless (your
# name, My Profile, API Auth Token). PAPERLESS_URL if Paperless isn't at
# this machine's address and its port in the store.
PAPERLESS_TOKEN=
PAPERLESS_URL=
# Without a token, Documents shows the files themselves, from this folder in
# STORAGE_DIR (Paperless's media folder, or any folder of documents).
# Empty: Documents.
DOCUMENTS_DIR=
# Tasks: your to-dos from Vikunja. A token from Vikunja (Settings, API
# Tokens: tasks, projects, labels), or your login (VIKUNJA_USER and
# VIKUNJA_PASSWORD). VIKUNJA_URL if it isn't at this machine's address.
VIKUNJA_TOKEN=
VIKUNJA_USER=
VIKUNJA_PASSWORD=
VIKUNJA_URL=
# Calendar: your calendars from Radicale (or any CalDAV server), read and changed.
# Your login there. CALDAV_URL if it isn't Radicale at this machine's address
# and its port in the store.
CALDAV_USER=
CALDAV_PASSWORD=
CALDAV_URL=

# A shell on this machine in adlerOS's Terminal window: on or off. Even when on,
# it's only there in adlerOS's admin mode (your password turns it on). Re-run
# install.sh after changing it.
ADLEROS_TERMINAL=off
# Where a new terminal starts. Empty: this homelab's folder.
ADLEROS_TERMINAL_DIR=
